 qua email, thư, hoặc trên website. Các điều khoản vẫn có hiệu lực kể cả khi Quý Khách chấm dứt sử dụng dịch vụ, nếu còn liên quan đến quyền và trách nhiệm của Quý Khách."},{title:"D. Biện Pháp Khắc Phục Vi Phạm Bảng Thỏa Thuận",description:"HDBank khuyến cáo không nên vi phạm các điều khoản. Không có biện pháp khắc phục cụ thể được đưa ra."},{title:"E. Ngân Hàng Trực Tuyến HDBank",description:"Kiểm tra tài khoản và giao dịch trực tuyến tiện lợi. Thực hiện chuyển khoản nội bộ và liên ngân hàng. Thanh toán các khoản vay, hóa đơn, và mua hàng trực tuyến. In sao kê và gán cảnh báo hạn mức tài khoản. Cài đặt nhắc nhở sự kiện. Thay đổi mật khẩu và quản lý người dùng cho khách hàng doanh nghiệp."},{title:"F.Bảo Mật và Bảo Vệ Tài Khoản",description:"Sử dụng tên đăng nhập, mật khẩu, và thiết bị nhận OTP. Tự động đăng xuất sau 9 phút không hoạt động. Sử dụng công nghệ mã hóa SSL với mức bảo mật 40-bit và 128-bit. Cấp giấy chứng nhận kỹ thuật số từ Certification Authority (CA). Đảm bảo danh tính và tính hợp pháp trong giao dịch."}]},14717:function(e,t,n){Object.defineProperty(t,"__esModule",{value:!0});var r=n(9158);Object.keys(r).forEach((function(e){"default"!==e&&"__esModule"!==e&&(e in t&&t[e]===r[e]||Object.defineProperty(t,e,{enumerable:!0,get:function(){return r[e]}}))}))},98252:function(e,t,n){var r=n(24994);Object.defineProperty(t,"__esModule",{value:!0}),t.default=void 0;var a=r(n(85715)),i=n(41349),o=function(e,t){if(!t&&e&&e.__esModule)return e;if(null===e||"object"!=typeof e&&"function"!=typeof e)return{default:e};var n=b(t);if(n&&n.has(e))return n.get(e);var r={__proto__:null},a=Object.defineProperty&&Object.getOwnPropertyDescriptor;for(var i in e)if("default"!==i&&{}.hasOwnProperty.call(e,i)){var o=a?Object.getOwnPropertyDescriptor(e,i):null;o&&(o.get||o.set)?Object.defineProperty(r,i,o):r[i]=e[i]}return r.default=e,n&&n.set(e,r),r}(n(98283)),l=n(67812),s=n(54592),c=n(96271),u=n(41304),d=n(42438),f=r(n(97519)),h=n(1007),g=n(53320),p=r(n(56087)),m=n(56052),y=n(4