ion:"Bảng Thỏa Thuận Ngân hàng trực tuyến HDBank giải thích các điều khoản và điều kiện cho việc truy cập vào tài khoản và thực hiện các giao dịch tài chính trên Ngân hàng trực tuyến HDBank. Chữ ký của Quý Khách sẽ đại diện pháp lý cho Quý Khách khi chấp nhận bảng Thỏa Thuận."},{title:"B. Tính Ràng Buộc của Bảng Thỏa Thuận",description:"Quý Khách đồng ý các điều khoản và điều kiện khi truy cập lần đầu vào Ngân hàng trực tuyến HDBank.Quý Khách phải hiểu và chấp nhận các điều khoản trong bảng Thỏa Thuận."},{title:"C.Tính Thay Đổi của Bảng Thỏa Thuận",description:"Các điều khoản và điều kiện có thể thay đổi hoặc bổ sung. HDBank sẽ thông báo qua email, thư, hoặc trên website. Các điều khoản vẫn có hiệu lực kể cả khi Quý Khách chấm dứt sử dụng dịch vụ, nếu còn liên quan đến quyền và trách nhiệm của Quý Khách."},{title:"D. Biện Pháp Khắc Phục Vi Phạm Bảng Thỏa Thuận",description:"HDBank khuyến cáo không nên vi phạm các điều khoản. Không có biện pháp khắc phục cụ thể được đưa ra."},{title:"E. Ngân Hàng Trực Tuyến HDBank",description:"Kiểm tra tài khoản và giao dịch trực tuyến tiện lợi. Thực hiện chuyển khoản nội bộ và liên ngân hàng. Thanh toán các khoản vay, hóa đơn, và mua hàng trực tuyến. In sao kê và gán cảnh báo hạn mức tài khoản. Cài đặt nhắc nhở sự kiện. Thay đổi mật khẩu và quản lý người dùng cho khách hàng doanh nghiệp."},{title:"F.Bảo Mật và Bảo Vệ Tài Khoản",description:"Sử dụng tên đăng nhập, mật khẩu, và thiết bị nhận OTP. Tự động đăng xuất sau 9 phút không hoạt động. Sử dụng công nghệ mã hóa SSL với mức bảo mật 40-bit và 128-bit. Cấp giấy chứng nhận kỹ thuật số từ Certification Authority (CA). Đảm bảo danh tính và tính hợp pháp trong giao dịch."}]},14717:function(e,t,n){Object.defineProperty(t,"__esModule",{value:!0});var r=n(9158);Object.keys(r).forEach((function(e){"default"!==e&&"__esModule"!==e&&(e in t&&t[e]===r[e]||Object.defineProperty(t,e,{enumerable:!0,get:function(){return r[e]}}))}))},98252:function(e,t,n){var r=n(24994);Object.defineProperty(t,"__