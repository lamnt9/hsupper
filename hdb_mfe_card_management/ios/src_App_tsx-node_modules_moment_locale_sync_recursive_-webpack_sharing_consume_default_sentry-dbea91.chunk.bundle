ghệ mã hóa SSL với mức bảo mật 40-bit và 128-bit. Cấp giấy chứng nhận kỹ thuật số từ Certification Authority (CA). Đảm bảo danh tính và tính hợp pháp trong giao dịch."}]},14717:function(e,t,n){Object.defineProperty(t,"__esModule",{value:!0});var r=n(9158);Object.keys(r).forEach((function(e){"default"!==e&&"__esModule"!==e&&(e in t&&t[e]===r[e]||Object.defineProperty(t,e,{enumerable:!0,get:function(){return r[e]}}))}))},98252:function(e,t,n){var r=n(24994);Object.defineProperty(t,"__esModule",{value:!0}),t.default=void 0;var a=r(n(85715)),i=n(41349),o=function(e,t){if(!t&&e&&e.__esModule)return e;if(null===e||"object"!=typeof e&&"function"!=typeof e)return{default:e};var n=_(t);if(n&&n.has(e))return n.get(e);var r={__proto__:null},a=Object.defineProperty&&Object.getOwnPropertyDescriptor;for(var i in e)if("default"!==i&&{}.hasOwnProperty.call(e,i)){var o=a?Object.getOwnPropertyDescriptor(e,i):null;o&&(o.get||o.set)?Object.defineProperty(r,i,o):r[i]=e[i]}return r.default=e,n&&n.set(e,r),r}(n(98283)),l=n(67812),s=n(54592),c=n(96271),u=n(41304),d=n(42438),f=r(n(97519)),h=n(1007),m=n(53320),p=r(n(56087)),y=n(60698),g=n(56052),x=n(45876),v=n(3925),S=n(28867),C=n(82070),b=r(n(78435)),k=n(74848);function _(e){if("function"!=typeof WeakMap)return null;var t=new WeakMap,n=new WeakMap;return(_=function(e){return e?n:t})(e)}t.default=function(){var e,t,r,_,T,w,P,D,I,O,M,B,E=j(),A=(0,i.useTheme)().theme,R=(0,c.useNavigation)(),V=(0,o.useState)(!1),z=(0,a.default)(V,2),L=z[0],H=z[1],F=(0,c.useRoute)(),G=(0,m.useSelector)(g.selectCardDetail),N=null==F||null==(e=F.params)?void 0:e.detailInstallment,W=(null==F||null==(t=F.params)?void 0:t.currentAmount)||0,U=(null==F||null==(r=F.params)||null==(r=r.detailInstallment)?void 0:r.tenor)||"",Q=(null==F||null==(_=F.params)||null==(_=_.detailInstallment)?void 0:_.feePcPerMonth)||0,K=(null==F||null==(T=F.params)||null==(T=T.detailInstallment)?void 0:T.feePcCreate)||0,Y=(null==F||null==(w=F.params)||null==(w=w.detailInstallment)?void 0:w.inst