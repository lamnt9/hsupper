ập sinh trắc học","captureId":"Bắt đầu chụp"},"hv_error_code":{"unclearTitle":"Thông báo","documents_failed":"Ảnh giấy tờ không hợp lệ","lost_original_documents":"Ảnh chụp bị mất góc","invalid_document_information":"Thông tin giấy tờ không hợp lệ","expired_documents":"Giấy tờ đã hết hạn","information_does_not_match":"Thông tin giấy tờ không hợp lệ","suspected_forgery":"Ảnh giấy tờ không hợp lệ","photocopied_documents":"Ảnh chụp không phải giấy tờ gốc","over_glued_documents":"Ảnh chụp không phải giấy tờ gốc","does_not_match_face":"Khuôn mặt chưa khớp. Quý khách vui lòng thực hiện lại","multiple_faces_in_frame":"Khuôn mặt chưa khớp. Quý khách vui lòng thực hiện lại","face_not_captured_directly":"Khuôn mặt chưa khớp. Quý khách vui lòng thực hiện lại","face_is_covered":"Khuôn mặt chưa khớp. Quý khách vui lòng thực hiện lại","nfc_not_detected":"Đã có lỗi xảy ra với thông tin của bạn","authentication_failure":"Đã có lỗi xảy ra với thông tin của bạn"},"bottom_error":{"notification":"Thông báo","common_error":"Đã xảy ra lỗi hệ thống, quý khách vui lòng thử lại sau.","cancel":"Huỷ","confirm":"Xác nhận","close":"Đóng"},"bottom_notification":{"notification":"Thông báo","timeout_title":"Quá thời gian giao dịch","timeout_description":"Đã quá thời gian thực hiện giao dịch. Quý khách vui lòng thực hiện lại hoặc liên hệ 19006060 để được hỗ trợ.","btn_hotline":"Gọi Hotline","btn_try_again":"Thực hiện lại","close":"Đóng","title_warming_support_bio":"Nguy cơ lộ thông tin cá nhân. Trước khi chia sẻ, hãy đảm bảo rằng:","description_warming_support_bio_1":"Người thu thập hộ sinh trắc học là người có quen biết với bạn","description_warming_support_bio_2":"Sau khi thực hiện thu thập hộ NFC thành công, vui lòng cất giữ, không đưa giấy tờ tuỳ thân cho bất kỳ ai sỡ hữu nhằm sử dụng với các mục đích khác","understood_button":"Tôi đã hiểu"},"onboarding_support_bio_qr_generate":{"title":"Chia sẻ mã QR","main_title":"Chia sẻ Mã QR\\nđể người hỗ trợ thực hiện NFC","description":"Vui lòng chia sẻ m