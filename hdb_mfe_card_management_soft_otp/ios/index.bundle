px rgba(0, 0, 0, 0.2);\n            background-color: white;\n            width: 100%;\n            height: auto !important;\n            border-radius: 2px;\n            display: block;\n          }\n          #loading {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            color: #666;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n          }\n          .loader {\n            border: 4px solid #f3f3f3;\n            border-top: 4px solid #3498db;\n            border-radius: 50%;\n            width: 24px;\n            height: 24px;\n            animation: spin 1s linear infinite;\n            margin-bottom: 10px;\n          }\n          @keyframes spin {\n            0% { transform: rotate(0deg); }\n            100% { transform: rotate(360deg); }\n          }\n          .page-wrapper {\n            width: 100%;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n          }\n          .page-separator {\n            width: 80%;\n            margin: 0 auto;\n            border-top: 1px dashed #ccc;\n            margin-top: 5px;\n          }\n        </style>\n      </head>\n      <body>\n        <div id="pdf-viewer">\n          <div id="loading">\n            <div class="loader"></div>\n            <div>Loading PDF...</div>\n          </div>\n          <div id="pdf-container"></div>\n        </div>\n        \n        <script>\n          // Configure PDF.js worker\n          pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.7.107/pdf.worker.min.js';\n          \n          // Variables\n          let currentPage = 1;\n          let totalPages = 0;\n          let currentScale = 1.0;\n          let pdf = null;\n          \n          // Elements\n          const container = document.getElementById('pdf-container');\n          \n          // Calculate viewport dimensions\n          const viewportWidth = window.innerWidth;\n          \n          // Handle PDF loading\n          const pdfData = atob('${t}');\n          \n          // Convert base64 to array buffer\n          const pdfBytes = new Uint8Array(pdfData.length);\n          for (let i = 0; i < pdfData.length; i++) {\n            pdfBytes[i] = pdfData.charCodeAt(i);\n          }\n          \n          // Function to render all pages\n          async function renderAllPages(scale = currentScale) {\n            // Clear container\n            container.innerHTML = '';\n            \n            // Base scale calculated to fit page in viewport\n            const firstPage = await pdf.getPage(1);\n            const viewport = firstPage.getViewport({ scale: 1.0 });\n            const baseScale = (viewportWidth * 0.95) / viewport.width;\n            \n            // Apply zoom level\n            const finalScale = baseScale * scale;\n            \n            // Render all pages\n            for (let pageNum = 1; pageNum <= totalPages; pageNum++) {\n              const page = await pdf.getPage(pageNum);\n              const scaledViewport = page.getViewport({ scale: finalScale });\n              \n              // Create wrapper for this page\n              const wrapper = document.createElement('div');\n              wrapper.className = 'page-wrapper';\n              \n              // Create canvas for this page\n              const canvas = document.createElement('canvas');\n              canvas.className = 'pdf-page';\n              canvas.width = scaledViewport.width;\n              canvas.height = scaledViewport.height;\n              wrapper.appendChild(canvas);\n              \n              // Page divider if not last page\n              if (pageNum < totalPages) {\n                const divider = document.createElement('div');\n                divider.className = 'page-separator';\n                wrapper.appendChild(divider);\n              }\n              \n              container.appendChild(wrapper);\n              \n              // Render page to canvas\n              const context = canvas.getContext('2d');\n              const renderContext = {\n                canvasContext: context,\n                viewport: scaledViewport\n              };\n              \n              await page.render(renderContext).promise;\n              \n              // When first page is rendered\n              if (pageNum === 1) {\n                // Notify that PDF is loaded\n                window.ReactNativeWebView.postMessage('PDF_LOADED');\n              }\n            }\n            \n            // Set up scroll tracking to identify current page\n            setupScrollTracking();\n          }\n          \n          // Function to track scrolling and identify current page\n          function setupScrollTracking() {\n            container.addEventListener('scroll', function() {\n              const pages = document.querySelectorAll('.pdf-page');\n              const containerRect = container.getBoundingClientRect();\n              \n              // Find most visible page\n              let maxVisibleArea = 0;\n              let maxVisiblePage = 1;\n              \n              pages.forEach((page, index) => {\n                const pageRect = page.getBoundingClientRect();\n                const visibleHeight = Math.min(pageRect.bottom, containerRect.bottom) - \n                                    Math.max(pageRect.top, containerRect.top);\n                \n                if (visibleHeight > maxVisibleArea) {\n                  maxVisibleArea = visibleHeight;\n                  maxVisiblePage = index + 1;\n                }\n              });\n              \n              if (currentPage !== maxVisiblePage) {\n                currentPage = maxVisiblePage;\n                \n                // Report current page to React Native\n                window.ReactNativeWebView.postMessage(JSON.stringify({\n                  type: 'PAGE_CHANGED',\n                  page: currentPage\n                }));\n              }\n            });\n          }\n          \n          // Add pinch/zoom gesture support\n          document.addEventListener('touchstart', handleTouchStart, false);\n          document.addEventListener('touchmove', handleTouchMove, false);\n          \n          let touchDistance = 0;\n          \n          function handleTouchStart(e) {\n            if (e.touches.length === 2) {\n              touchDistance = Math.hypot(\n                e.touches[0].pageX - e.touches[1].pageX,\n                e.touches[0].pageY - e.touches[1].pageY\n              );\n            }\n          }\n          \n          function handleTouchMove(e) {\n            if (e.touches.length === 2) {\n              e.preventDefault();\n              \n              const newDistance = Math.hypot(\n                e.touches[0].pageX - e.touches[1].pageX,\n                e.touches[0].pageY - e.touches[1].pageY\n              );\n              \n              if (Math.abs(newDistance - touchDistance) > 10) {\n                if (newDistance > touchDistance) {\n                  // Zoom in\n                  currentScale *= 1.1;\n                } else {\n                  // Zoom out\n                  currentScale *= 0.9;\n                }\n                \n                renderAllPages(currentScale);\n                touchDistance = newDistance;\n              }\n            }\n          }\n          \n          // Load the PDF document\n          async function initPDF() {\n            try {\n              pdf = await pdfjsLib.getDocument({ data: pdfBytes }).promise;\n              \n              // Get total pages\n              totalPages = pdf.numPages;\n              \n              // Report the number of pages\n              window.ReactNativeWebView.postMessage(JSON.stringify({\n                type: 'PAGE_COUNT',\n                count: totalPages\n              }));\n              \n              // Render all pages\n              renderAllPages();\n              \n              // Hide loading indicator\n              document.getElementById('loading').style.display = 'none';\n            } catch (error) {\n              console.error('Error loading PDF', error);\n              window.ReactNativeWebView.postMessage(JSON.stringify({\n                type: 'ERROR',\n                message: 'Error loading PDF: ' + error.message\n              }));\n            }\n          }\n          \n          // Initialize\n          initPDF();\n        <\/script>\n      </body>\n      </html>\n    `,baseUrl:""},style:d.webView,javaScriptEnabled:!0,domStorageEnabled:!0,onMessage:function(e){try{var t=JSON.parse(e.nativeEvent.data);"PAGE_COUNT"===t.type&&n&&n(t.count),"PAGE_CHANGED"===t.type&&r&&r(t.page),"ERROR"===t.type&&s&&s(new Error(t.message))}catch(e){}},onError:function(e){var t=e.nativeEvent;s&&s(new Error(t.description||"PDF loading error"))}})}):null}},59099:function(e,t,n){var r=n(24994);Object.defineProperty(t,"__esModule",{value:!0}),t.useDefaultLocationType=t.textProcessingPresets=t.splitAddress=t.modelUpdateLeadManagement=t.hashMD5=t.getCurrentTimestamp=t.getCurrentDate=t.formatCurrencyWithUnit=t.VIETNAMESE_TEXT_REGEX=t.VIETNAMESE_REGEX=t.URL_VIDEO_1CC=t.URL_FULL=t.SECURITY_KEY=t.SCREEN_HV=t.ONECCDATA=t.MAX_LENGTH_SECURITY=t.MAX_LENGTH_INCOME=t.MAX_EMAIL_LENGTH=t.MAX_COMPANY_LENGTH=t.MAX_ADDRESS_LENGTH=t.ENVENT_HV=t.EMOIJ_REGEX=t.EMAIL_BANKING=t.DEFAULT_PARTNER_ID=t.DEFAULT_NATIONAL_TYPE=t.DEFAULT_NATIONALITY=t.DEFAULT_LEAD_STATUS_ID=t.DEFAULT_CAMPAING_ID=t.APP_NAME_HV=void 0;var a=r(n(41213)),i=n(48444),o=n(71648),l=n(85048),u=(t.ONECCDATA=[{name:"HDBank Petrolimex 4in1",contractProductCode:"MC_DB_MULTI_PETRO",cardProductCode:"MC_DB_MULTI_PETRO_M"},{name:"HDBank Vietjet Classic",contractProductCode:"VS_CR_CLL_VJ",cardProductCode:"VS_CR_CLL_VJ_M"},{name:"HDBank Vietjet Platinum",contractProductCode: