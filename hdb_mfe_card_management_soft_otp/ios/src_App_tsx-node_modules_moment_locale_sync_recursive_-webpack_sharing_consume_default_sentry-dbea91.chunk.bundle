Cấp giấy chứng nhận kỹ thuật số từ Certification Authority (CA). Đảm bảo danh tính và tính hợp pháp trong giao dịch."}]},14717:function(e,t,n){Object.defineProperty(t,"__esModule",{value:!0});var r=n(9158);Object.keys(r).forEach((function(e){"default"!==e&&"__esModule"!==e&&(e in t&&t[e]===r[e]||Object.defineProperty(t,e,{enumerable:!0,get:function(){return r[e]}}))}))},98252:function(e,t,n){var r=n(24994);Object.defineProperty(t,"__esModule",{value:!0}),t.default=void 0;var i=r(n(85715)),a=n(41349),A=function(e,t){if(!t&&e&&e.__esModule)return e;if(null===e||"object"!=typeof e&&"function"!=typeof e)return{default:e};var n=b(t);if(n&&n.has(e))return n.get(e);var r={__proto__:null},i=Object.defineProperty&&Object.getOwnPropertyDescriptor;for(var a in e)if("default"!==a&&{}.hasOwnProperty.call(e,a)){var A=i?Object.getOwnPropertyDescriptor(e,a):null;A&&(A.get||A.set)?Object.defineProperty(r,a,A):r[a]=e[a]}return r.default=e,n&&n.set(e,r),r}(n(98283)),o=n(67812),l=n(54592),s=n(96271),u=n(18923),c=n(42438),d=r(n(97519)),f=n(1007),g=n(53320),h=r(n(56087)),m=n(56052),p=n(45876),y=n(3925),v=n(28867),C=n(82070),x=r(n(78435)),B=n(74848);function b(e){if("function"!=typeof WeakMap)return null;var t=new WeakMap,n=new WeakMap;return(b=function(e){return e?n:t})(e)}t.default=function(){var e,t,r,b,S,I,w,k,P,T,D,j,O,R,M=E(),Q=(0,a.useTheme)().theme,H=(0,s.useNavigation)(),L=(0,A.useState)(!1),z=(0,i.default)(L,2),V=z[0],F=z[1],N=(0,s.useRoute)(),G=(0,g.useSelector)(m.selectCardDetail),X=null==N||null==(e=N.params)?void 0:e.detailInstallment,U=(null==N||null==(t=N.params)?void 0:t.currentAmount)||0,W=(null==N||null==(r=N.params)||null==(r=r.detailInstallment)?void 0:r.tenor)||"",K=(null==N||null==(b=N.params)||null==(b=b.detailInstallment)?void 0:b.feePcPerMonth)||0,J=(null==N||null==(S=N.params)||null==(S=S.detailInstallment)?void 0:S.feePcCreate)||0,Y=(null==N||null==(I=N.params)||null==(I=I.detailInstallment)?void 0:I.instalmentServiceCode)||"",q=(null==N||null==(w=N.params)||nu