\n          }\n          #pdf-container {\n            flex: 1;\n            overflow: auto;\n            width: 100%;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n          }\n          .pdf-page {\n            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);\n            background-color: white;\n            width: 100%;\n            height: auto !important;\n            border-radius: 2px;\n            display: block;\n          }\n          #loading {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            color: #666;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n          }\n          .loader {\n            border: 4px solid #f3f3f3;\n            border-top: 4px solid #3498db;\n            border-radius: 50%;\n            width: 24px;\n            height: 24px;\n            animation: spin 1s linear infinite;\n            margin-bottom: 10px;\n          }\n          @keyframes spin {\n            0% { transform: rotate(0deg); }\n            100% { transform: rotate(360deg); }\n          }\n          .page-wrapper {\n            width: 100%;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n          }\n          .page-separator {\n            width: 80%;\n            margin: 0 auto;\n            border-top: 1px dashed #ccc;\n            margin-top: 5px;\n          }\n        </style>\n      </head>\n      <body>\n        <div id="pdf-viewer">\n          <div id="loading">\n            <div class="loader"></div>\n            <div>Loading PDF...</div>\n          </div>\n          <div id="pdf-container"></div>\n        </div>\n        \n        <script>\n          // Configure PDF.js worker\n          pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.7.107/pdf.worker.min.js';\n          \n          // Variables\n          let currentPage = 1;\n          let totalPages = 0;\n          let currentScale = 1.0;\n          let pdf = null;\n          \n          // Elements\n          const container = document.getElementById('pdf-container');\n          \n          // Calculate viewport dimensions\n          const viewportWidth = window.innerWidth;\n          \n          // Handle PDF loading\n          const pdfData = atob('${t}');\n          \n          // Convert base64 to array buffer\n          const pdfBytes = new Uint8Array(pdfData.length);\n          for (let i = 0; i < pdfData.length; i++) {\n            pdfBytes[i] = pdfData.charCodeAt(i);\n          }\n          \n          // Function to render all pages\n          async function renderAllPages(scale = currentScale) {\n            // Clear container\n            container.innerHTML = '';\n            \n            // Base scale calculated to fit page in viewport\n            const firstPage = await pdf.getPage(1);\n            const viewport = firstPage.getViewport({ scale: 1.0 });\n            const baseScale = (viewportWidth * 0.95) / viewport.width;\n            \n            // Apply zoom level\n            const finalScale = baseScale * scale;\n            \n            // Render all pages\n            for (let pageNum = 1; pageNum <= totalPages; pageNum++) {\n              const page = await pdf.getPage(pageNum);\n              const scaledViewport = page.getViewport({ scale: finalScale });\n              \n              // Create wrapper for this page\n              const wrapper = document.createElement('div');\n              wrapper.className = 'page-wrapper';\n              \n              // Create canvas for this page\n              const canvas = document.createElement('canvas');\n              canvas.className = 'pdf-page';\n              canvas.width = scaledViewport.width;\n              canvas.height = scaledViewport.height;\n              wrapper.appendChild(canvas);\n              \n              // Page divider if not last page\n              if (pageNum < totalPages) {\n                const divider = document.createElement('div');\n                divider.className = 'page-separator';\n                wrapper.appendChild(divider);\n              }\n              \n              container.appendChild(wrapper);\n              \n              // Render page to canvas\n              const context = canvas.getContext('2d');\n              const renderContext = {\n                canvasContext: context,\n                viewport: scaledViewport\n              };\n              \n              await page.render(renderContext).promise;\n              \n              // When first page is rendered\n              if (pageNum === 1) {\n                // Notify that PDF is loaded\n                window.ReactNativeWebView.postMessage('PDF_LOADED');\n              }\n            }\n            \n            // Set up scroll tracking to identify current page\n            setupScrollTracking();\n          }\n          \n          // Function to track scrolling and identify current page\n          function setupScrollTracking() {\n            container.addEventListener('scroll', function() {\n              const pages = document.querySelectorAll('.pdf-page');\n              const containerRect = container.getBoundingClientRect();\n              \n              // Find most visible page\n              let maxVisibleArea = 0;\n              let maxVisiblePage = 1;\n              \n              pages.forEach((page, index) => {\n                const pageRect = page.getBoundingClientRect();\n                const visibleHeight = Math.min(pageRect.bottom, containerRect.bottom) - \n                                    Math.max(pageRect.top, containerRect.top);\n                \n                if (visibleHeight > maxVisibleArea) {\n                  maxVisibleArea = visibleHeight;\n                  maxVisiblePage = 