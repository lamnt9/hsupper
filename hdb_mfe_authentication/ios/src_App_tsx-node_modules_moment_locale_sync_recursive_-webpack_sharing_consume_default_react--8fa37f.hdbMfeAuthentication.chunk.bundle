ớp, vui lòng thử lại.","title_pin_fail":"Mã PIN đã bị hủy do nhập sai vượt số lần quy định","action_pin_fail_second":"Thử lại với mã PIN khác","content_pin_fail":"Vui lòng nhấn “Đặt lại mã PIN” để tiếp tục.","action_pin_fail_first":"Đặt lại mã PIN","title_confirm_pin_password_success":"Tạo mật khẩu và mã PIN đăng nhập mới thành công!","content_confirm_pin_password_success":"Vui lòng không chia sẻ mật khẩu với bất kỳ ai.","title_confirm_pin_success":"Tạo mã PIN đăng nhập mới thành công!","content_confirm_pin_success":"Vui lòng không chia sẻ mã PIN với bất kỳ ai.","action_label_confirm_success":"Đóng","title_confirm_fail":"Tạo mật khẩu và mã PIN đăng nhập mới không thành công!","content_confirm_fail":"Rất tiếc đã có lỗi xảy ra trong quá trình tạo mật khẩu và tạo mã PIN đăng nhập nhanh. Vui lòng kiểm tra và thực hiện lại.","action_label_confirm_fail":"Đóng","cancel":"Hủy","title_sms_otp":"Nhập mã xác nhận","enter_login_pin":"Vui lòng nhập mã PIN đăng nhập"},"create_password":{"title":"Tạo <b>mật khẩu mới</b> của bạn","message":"Vui lòng đảm bảo mật khẩu mới khác với 4 mật khẩu gần nhất bạn đã sử dụng.","userName":"Tên đăng nhập","password":"Mật khẩu","new_password":"Mật khẩu mới","error_special_chars":"Vui lòng không sử dụng kí tự có dấu. Bạn có thể sử dụng các kí tự như ! % @ . ","error_include_password":"Mật khẩu không được chứa từ Password.","error_sequential_password":"Mật khẩu không được sử dụng toàn bộ ký tự trùng nhau, hoặc liên tục theo thứ tự trong bảng chữ cái, chữ số","error_not_match":"Vui lòng đảm bảo 2 mật khẩu đều trùng khớp.","confirm_password":"Xác nhận mật khẩu","confirm_new_password":"Xác nhận mật khẩu mới","validate_title":"Mật khẩu hợp lệ cần có:","at_least_8_chars":"Tối thiểu 8 kí tự.","include_upper_lower_cases":"Bao gồm ký tự VIẾT HOA và viết thường","include_number":"Bao gồm ký tự là số từ 0-9","include_special_chars":"Bao gồm ký tự đặc biệt","btn_create_password":"Tạo mật khẩu","passTerm":"Quy định đặt mật khẩu","termCreatePassword":["Phải có 