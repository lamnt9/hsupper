n dịch vụ này. Vui lòng thực hiện lại sau &&{{expiredAt}}&& hoặc liên hệ &&Chi nhánh/Phòng giao dịch&& HDBank gần nhất để đổi mật khẩu."},"incorrect_data":{"title":"Thông tin của Quý khách không chính xác!","confirm":"Đóng","message":"Quý khách vui lòng kiểm tra lại hoặc liên hệ Hotline &&1900 6060&& để được hỗ trợ."},"too_many_attempts":{"title":"Thông báo!","confirm":"Đóng","message":"Quý khách đã sai quá số lần quy định do thông tin xác minh không hợp lệ. Quý khách vui lòng thử lại sau &&{{expiredAt}} giờ&&"},"wrong_pin":{"title":"Thông báo","confirm":"Đặt lại mã PIN","message":"Mã PIN đăng nhập đã bị hủy do nhập sai quá số lần quy định. Quý khách vui lòng chọn Đặt lại mã PIN để tiến hành đăng nhập bằng mật khẩu và Cài đặt lại mã PIN để sử dụng."},"cccd":"Số CC/CCCD","fullname":"Họ và tên","phone_registed":"Số điện thoại đăng ký DV eBanking","forgot_username":"Quên tên đăng nhập?","user_name":"Tên đăng nhập","enter_user_name":"Nhập tên đăng nhập","continue":"Tiếp tục","notification":"Thông báo","term_and_conditions":"Tôi đã đọc, hiểu rõ và đồng ý với &&Điều khoản - Điều kiện&& dịch vụ cấp lại mật khẩu của HDBank","wrong_password_message_lock":"Dịch vụ của Quý khách đã bị khóa. Quý khách có thể thực hiện cấp lại mật khẩu ở tính năng Quên mật khẩu để mở khóa hoặc liên hệ Hotline &&19006060&& để được hỗ trợ. ","wrong_password_message":"Quý khách đã nhập sai thông tin mật khẩu đăng nhập {{times}} lần. Dịch vụ sẽ bị khóa nếu nhập sai mật khẩu đăng nhập liên tiếp 3 lần","forgot_password":"Quên mật khẩu","confirm":"Ok, tôi đã hiểu","close":"Đóng","try_again":"Thử lại","title":"Quy định đặt mật khẩu","min_length":"Phải có độ dài tối thiểu &&08 ký tự&&","include_chars":"Bao gồm các ký tự chữ và số, có chứa &&CHỮ HOA và chữ thường&& hoặc các ký tự đặc biệt bao gồm |@#$%^&*_-+=/","no_password_word":"Mật khẩu không được chứa từ password","no_repeated_or_sequential_chars":"Mật khẩu không được sử dụng toàn bộ ký tự trùng nhau hoặc liên tục theo thứ tự trong bảng chữ cái, chữ số.","no_recent_passwords":"Không thể dùng lại 4 mật khẩu gần đây nhất","validity_period":"Có thời gian hiệu lực tối đa &&12 tháng&&.","change_on_first_login":"Khách hàng phải đổi mật khẩu ngay &&lần đăng nhập đầu tiên&&.","email_notification":"Mật khẩu mới khi tạo thông tin đăng nhập sẽ được hệ thống tự động gửi vào &&email&& đăng ký của khách hàng.","lock_after_attempts":"Tài khoản của khách hàng sẽ bị khóa sau &&05 lần&& đăng nhập không thành công.","change_login_password":"Đổi mật khẩu đăng nhập","bio_locked":"Hình thức xác thực Sinh trắc học của Quý khách đang bị khóa. Vui lòng thực hiện mở khóa sinh trắc học hoặc chọn phương thức xác thực khác để tiếp tục đổi mật khẩu đăng nhập","use_old_password":"Dùng mật khẩu cũ","use_sms_otp":"Dùng SMS OTP","create_ur_new_password":{"no_password":"Mật khẩu không được chứa từ Password","password_not_match":"Vui lòng đảm bảo 2 mật khẩu đều trùng khớp.","contain_old_password":"Mật khẩu mới không được chứa mật khẩu cũ","enter_password":"Nhập &&mật khẩu&& hiện tại","create_your_password":"Tạo &&mật khẩu&& của bạn","password":"Mật khẩu","create_desc_1":"Vui lòng đảm bảo mật khẩu mới khác với 4 mật khẩu gần nhất bạn đã sử dụng.","confirm_password":"Xác nhận mật khẩu","valid_password_include":"Mật khẩu hợp lệ cần có:","min_length":"Tối thiểu 8 kí tự.","uppercase_lowercase":"Bao gồm ký tự VIẾT HOA và viết thường","numbers":"Bao gồm ký tự là số từ 0-9","special_characters":"Bao gồm ký tự đặc biệt","password_policy":"Quy định đặt mật khẩu","confirm":"Xác nhận","forget_password":"Quên mật khẩu","enter_password_of_you":"Nhập &&mật khẩu&& của bạn","continue":"Tiếp tục"},"create_login_pin":{"create_login_pin":"Tạo &&mã PIN&& đăng nhập nhanh","pin_vadity":"Nhập mã PIN có 6 chữ số khác nhau. Mã PIN đăng nhập có hiệu lực 12 tháng","confirm_login_pin":"Xác nhận &&mã PIN&&","log_in_faceid":"Đăng nhập với face ID","pin_same_old":"Mã PIN không được trùng với mã PIN đăng nhập hiện tại","pin_same_pin_otp":"Mã PIN không trùng khớp với Mã PIN HDBank